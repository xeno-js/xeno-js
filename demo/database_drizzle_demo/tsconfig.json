{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      // Diciamo a TypeScript: "Quando vedi @gantry5, ignora node_modules
      // e vai a leggere direttamente il codice sorgente TS del framework!"
      "@gantry5": ["../../src/index.ts"],
      "@/*": ["../../src/*"]
    }
  },
  "include": ["**/*.ts"]
}
