{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@xeno/core": ["../../src/index.ts"],
      "@/*": ["../../src/*"]
    }
  },
  "include": ["**/*.ts"]
}
