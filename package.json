{
  "name": "@xeno-js/core",
  "version": "0.1.3",
  "description": "Xeno agnostic core — DDD + Clean Architecture npm package",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xeno-js/xeno-js.git"
  },
  "bugs": {
    "url": "https://github.com/xeno-js/xeno-js/issues"
  },
  "homepage": "https://www.xeno-js.it",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --config eslint.config.mjs \"src/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint --config eslint.config.mjs \"src/**/*.ts\" --fix --max-warnings=0",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint:fix && npm run test",
    "verify:commit": "npm run lint-staged && npm run test",
    "verify:push": "npm run check",
    "prepare": "husky",
    "prepublishOnly": "npm run check && npm run build",
    "release": "npm run prepublishOnly && npm publish",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate"
  },
  "keywords": [
    "ddd",
    "clean-architecture",
    "core",
    "kernel",
    "domain-driven-design",
    "mediator",
    "event-sourcing",
    "cqrs",
    "repository-pattern",
    "supabase",
    "zod"
  ],
  "author": "Xeno",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@libsql/client": "^0.14.0",
    "@sentry/node": "^11.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "@xeno-js/shared": "^0.1.6",
    "axios": "^1.20.0",
    "cockatiel": "^4.0.0",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "p-limit": "^7.3.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "peerDependenciesMeta": {
    "@libsql/client": {
      "optional": true
    },
    "@sentry/node": {
      "optional": true
    },
    "@supabase/supabase-js": {
      "optional": true
    },
    "@supabase/ssr": {
      "optional": true
    },
    "axios": {
      "optional": true
    },
    "cockatiel": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "p-limit": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "pino": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "zod": {
      "optional": false
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@libsql/client": "^0.18.0",
    "@sentry/node": "^11.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@xeno-js/shared": "^0.1.6",
    "axios": "^1.20.0",
    "cockatiel": "^4.0.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "ioredis": "^6.0.0",
    "lint-staged": "^17.5.1",
    "p-limit": "^7.3.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "prettier": "^3.9.9",
    "tsc-alias": "^1.9.5",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.1",
    "tsup": "^8.5.1",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
